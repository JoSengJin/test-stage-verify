{
  "name": "test-stage-framework",
  "version": "1.0.0",
  "description": "Stage verification tool for deployment candidates (never shipped to consumers)",
  "main": "dist/index.js",
  "workspaces": [
    "examples/*"
  ],
  "scripts": {
    "build": "tsc",
    "stage": "node --env-file-if-exists=.env.stage stage/src/cli.ts --project examples/order-client",
    "stage:server": "node --env-file-if-exists=.env.stage examples/order-stage-server/server.mjs",
    "test": "node --test \"stage/test/**/*.test.ts\"",
    "stage:dev": "node --env-file-if-exists=.env.stage stage/src/cli.ts --watch --project examples/order-client"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "typescript": "^6.0.3"
  },
  "private": true,
  "dependencies": {
    "pnpm": "5.4.0"
  }
}
